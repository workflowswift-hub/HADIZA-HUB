rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Produits : tout le monde peut lire (catalogue public),
    // seul le compte admin (toi) peut écrire.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Commandes : lecture/écriture réservées à l'admin connecté
    // (les commandes sont créées manuellement par toi depuis le dashboard,
    // suite à la confirmation reçue sur WhatsApp).
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
  }
}
